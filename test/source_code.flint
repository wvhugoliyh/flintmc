def func broadcast(text) {
  run $tellraw @a "$(text)";
}

def load main_load {
  fibbonacci:vars a = 1;
  fibbonacci:vars b = 1;
  fibbonacci:vars c = a + b;
}

def tick main_tick {
  /* Every tick, calculate the next 9 term of the Fibbonacci
  sequence and broadcast it */
  repeat 3 {
    fibbonacci:vars a = b + c;
    fibbonacci:vars b = a + c;
    fibbonacci:vars c = a + b;

    broadcast(fibbonacci:vars a);
    broadcast(fibbonacci:vars b);
    broadcast(fibbonacci:vars c);
  }
}