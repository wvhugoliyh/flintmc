def func broadcast(text) {
  run $tellraw @a "$(text)";
}
def load main_load {
  a = 1;
  b = 1;
  c = a + b;
}

def tick main_tick {
  // Every tick, calculate the next 3 term of the Fibbonacci sequence
  a = b + c;
  b = a + c;
  c = a + b;

  // Broadcast the 3 terms to everyone
  broadcast(a);
  broadcast(b);
  broadcast(c);
}