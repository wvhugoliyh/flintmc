def func broadcast(text) {
  run $tellraw @a "$(text)";
}

def load main_load {
  a = 1;
  b = 1;
  c = a + b;
}

def tick main_tick {
  /* Every tick, calculate the next 9 term of the Fibbonacci
  sequence and broadcast it */
  repeat 3 {
    a = b + c;
    b = a + c;
    c = a + b;

    broadcast(a);
    broadcast(b);
    broadcast(c);
  }
}