items{item}: (item ",")* item?

start: definition*

?definition: func_def

func_def: "def" "Function" resource_location "(" _items{ID} ")" code_block


code_block: statement | "{" statement* "}"

?statement: RAW ";"
          | assignment ";"
          | func_call ";"

assignment: variable "=" value
func_call: ID "(" _items{value} ")"


?value: array | expr | STRING_LITERAL

variable: ID
        | (resource_location | entity | coordinate) (ID | STRING_LITERAL) -> nbt
        | atom "." (ID | STRING_LITERAL)                                  -> map_property
        | atom "[" expr "]"                                               -> array_item

array: "[" _items{value} "]"
map: "{" (STRING_LITERAL ":" value ",")* (STRING_LITERAL ":" value)? "}"

?expr: (expr "||")? conjunction
?conjunction: (conjunction "&&")? negation
?negation: comparison | "!" negation
?comparison: (sum COMPARATOR)? sum
?sum: (sum SIGN)? term
?term: (term MUL_OP)? signed_power
?signed_power: power | SIGN signed_power
?power: atom ("^" power)?
?atom: "(" expr ")" | map | func_call | variable | INT_LITERAL | FLOAT_LITERAL | BOOLEAN_LITERAL

resource_location: ID ":" ID
entity: UUID | ID | TARGET_SELECTOR
coordinate: "(" value "," value "," value ","? ")"


ID: /[a-zA-Z_][a-zA-Z0-9_]*/

RAW.-1: /.+?(?<=[^\\](\\\\)*)(?=;)/

INT_LITERAL: /[0-9]+/
FLOAT_LITERAL: /[0-9]*\.[0-9]+/
BOOLEAN_LITERAL: /True|False/
STRING_LITERAL: /("""|''')[\s\S]*?(?<=[^\\](\\\\)*)\1|(["']).*?(?<=[^\\](\\\\)*)\3/

SIGN: /[+-]/
MUL_OP: /[*\/]/
COMPARATOR: /==|!=|<|>|<=|>=/

UUID: /[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/
TARGET_SELECTOR: /@[aenpsr]/

%ignore /\s+/
%ignore /\/{2}.*|\/\*[\s\S]*?\*\//